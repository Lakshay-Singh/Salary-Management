# Copy to .env and fill in. The API refuses to start if a required value is missing or invalid.
# An empty value counts as missing.

# development | test | production (optional, default: development)
NODE_ENV=
# Port the API listens on (optional, default: 3000; Railway sets it)
PORT=

# Neon pooled connection string, used by the app at runtime
DATABASE_URL=
# Neon direct connection string, used by Prisma migrations
DIRECT_URL=

# Exact frontend origin, no path or trailing slash (locally: http://localhost:5173)
ALLOWED_ORIGIN=

# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# The single HR Manager login
HR_USERNAME=
# bcrypt hash from: npm run hash-password -- '<password>'
# Wrap it in single quotes: the hash contains $ characters.
HR_PASSWORD_HASH=
