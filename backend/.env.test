# Integration tests only: the local Docker Postgres from docker-compose.yml (start it with npm run db:up).
# Not a secret: these credentials exist only inside that local container.
# The database name must end in _test; the test setup refuses anything else because the tests truncate tables.
DATABASE_URL=postgresql://salaries:salaries@localhost:5433/salaries_test
DIRECT_URL=postgresql://salaries:salaries@localhost:5433/salaries_test
